{
  "name": "passripple",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:app": "pnpm --filter @passripple/app dev",
    "dev:site": "pnpm --filter @passripple/site dev",
    "dev:coming-soon": "pnpm --filter @passripple/site dev:coming-soon",
    "dev:api": "pnpm --filter @passripple/worker-api dev",
    "build": "pnpm -r --if-present build",
    "build:coming-soon": "pnpm --filter @passripple/site build:coming-soon",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p workers/api/tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test:cov",
    "db:up": "docker compose -f db/compose.yaml up -d --build --wait",
    "db:down": "docker compose -f db/compose.yaml down -v",
    "db:migrate": "node scripts/db.ts migrate",
    "db:test": "node scripts/db.ts test",
    "db:api-login": "node scripts/db.ts api-login"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
