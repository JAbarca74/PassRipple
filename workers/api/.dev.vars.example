# Local settings and secrets for `wrangler dev`. Copy to `.dev.vars` (never committed) and
# fill in. In production each one is set with `wrangler secret put <NAME>`.

# Key of the HMAC over sign-in codes and staff codes: 32 or more random bytes, base64.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Use a different value in every environment. Secret.
SIGN_IN_PEPPER=

# The server's public key ring, sent to gate devices in every manifest. Public, not secret.
# For local development, `node scripts/dev-fixtures.ts seed` prints the ring of its
# development key, which signs the fixture tickets.
SERVER_PUBLIC_KEYS=[]

# Browser origins allowed to call sign-in and account erasure (the public site's
# /eliminar-datos page), comma-separated. Locally, the site's dev server.
ALLOWED_ORIGINS=http://localhost:5173

# `log` prints emails to the wrangler console and only works on localhost.
# Production uses `gmail` (ADR 0028); `ses` remains available.
MAIL_PROVIDER=log

# Sender of transactional mail (same values as MAIL_FROM_* in the root .env.example).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Gmail through Google Workspace, only when MAIL_PROVIDER=gmail: the service account's
# client_email and private_key from its JSON key file (the key is secret), and the mailbox
# it sends as if MAIL_FROM_ADDRESS is an alias of it.
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY=
GMAIL_SENDER_USER=

# Google Play's reviewers: this address signs in with this fixed six-digit code, without
# mail (src/reviewer.ts). Leave either empty to turn it off. Both secret.
REVIEW_SIGN_IN_EMAIL=
REVIEW_SIGN_IN_CODE=

# Amazon SES, only when MAIL_PROVIDER=ses. The access key is secret.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# The server's private key that signs ticket certificates (ADR 0035): a 32-byte Ed25519 seed
# in base64url, and its id in SERVER_PUBLIC_KEYS. Locally, the development key printed by
# `node scripts/dev-fixtures.ts seed` (id 1). Secret; the deployed key is id 2.
SERVER_SIGNING_KEY=
SERVER_SIGNING_KEY_ID=

# Origins of the app allowed to call the buyer's routes (events, orders, wallet).
APP_ORIGINS=http://localhost:5174

# The fee schedule (ADR 0033), as JSON. Business data: fill it in locally, never in Git.
# {"id":"<name>","rateBps":<basis points>,"fixedCrc":<colones>,"taxRateBps":<basis points>,"taxMode":"added"|"included"}
FEE_SCHEDULE=

# AES-256 key that encrypts attendees' document numbers (named tickets): 32 random bytes in
# base64url. Generate one with:
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# A different value in every environment. Secret.
ATTENDEE_DOC_KEY=

# The platform's SINPE Móvil number buyers pay to. Not in Git.
SINPE_NUMBER=

# How many colones above its price an order may be charged so no two pending orders share an
# amount (ADR 0031). 0 or empty: never more than the price.
UNIQUE_AMOUNT_MAX_OFFSET_CRC=
