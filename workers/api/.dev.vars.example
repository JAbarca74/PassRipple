# Local settings and secrets for `wrangler dev`. Copy to `.dev.vars` (never committed) and
# fill in. In production each one is set with `wrangler secret put <NAME>`.

# Key of the HMAC over sign-in codes and staff codes: 32 or more random bytes, base64.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Use a different value in every environment. Secret.
SIGN_IN_PEPPER=

# The server's public key ring, sent to gate devices in every manifest. Public, not secret.
# For local development, `node scripts/dev-fixtures.ts seed` prints the ring of its
# development key, which signs the fixture tickets.
SERVER_PUBLIC_KEYS=[]

# Browser origins allowed to call sign-in and account erasure (the public site's
# /eliminar-datos page), comma-separated. Locally, the site's dev server.
ALLOWED_ORIGINS=http://localhost:5173

# `log` prints emails to the wrangler console and only works on localhost.
# Production uses `gmail` (ADR 0028); `ses` remains available.
MAIL_PROVIDER=log

# Sender of transactional mail (same values as MAIL_FROM_* in the root .env.example).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Gmail through Google Workspace, only when MAIL_PROVIDER=gmail: the service account's
# client_email and private_key from its JSON key file (the key is secret), and the mailbox
# it sends as if MAIL_FROM_ADDRESS is an alias of it.
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY=
GMAIL_SENDER_USER=

# Amazon SES, only when MAIL_PROVIDER=ses. The access key is secret.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
