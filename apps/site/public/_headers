# Response headers for the public site, applied by Cloudflare Workers static assets (ADR 0026).
# The API origin placeholder in connect-src is replaced at build time with the origin of
# VITE_API_URL (vite.config.ts).
# Analytics may run here only after consent; widen script-src and connect-src for those
# providers when they are added, never on the app origin (invariant I8).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' __API_ORIGIN__; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
