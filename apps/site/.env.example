# Public site configuration. Copy to `.env` (never committed) and fill in.
# Every VITE_* value ends up in the browser bundle: only public identifiers here, no secrets.

# Origin of the app, where buying and the wallet live.
VITE_APP_URL=http://localhost:5174

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after consent;
# not read yet. Never set it for the app (invariant I8).
VITE_GA4_MEASUREMENT_ID=

# Public contact address on the company domain, shown on the site. Not read yet.
VITE_CONTACT_EMAIL=
