{
  "$schema": "../../workers/api/node_modules/wrangler/config-schema.json",
  // Public site: static assets only, no Worker script (ADR 0026). Deploy with an explicit
  // --config pointing at this file, after a --dry-run (README.md, "Deploy").
  "name": "passripple-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every path that is not a file gets index.html: the holding page in coming-soon mode.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "passripple.com", "custom_domain": true },
    { "pattern": "www.passripple.com", "custom_domain": true }
  ]
}
