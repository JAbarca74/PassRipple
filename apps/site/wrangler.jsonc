{
  "$schema": "../../workers/api/node_modules/wrangler/config-schema.json",
  // Public site: static assets only, no Worker script (ADR 0026). Deploy with an explicit
  // --config pointing at this file, after a --dry-run (README.md, "Deploy").
  "name": "passripple-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every path that is not a file gets 404.html with status 404, so search engines index
    // only real pages. The full site's client-side routes need "single-page-application"
    // back until its pages are pre-rendered (Phase 5).
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "passripple.com", "custom_domain": true },
    { "pattern": "www.passripple.com", "custom_domain": true }
  ]
}
