# Gate app settings, read when the app is bundled. Copy to `.env` (never committed).
# EXPO_PUBLIC_* values end up inside the app: never put a secret here.

# The API the gate talks to. From the Android emulator, the host machine is 10.0.2.2;
# from the iOS simulator, localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

# 1 only for UI-test builds: adds a hidden field that feeds QR text to the scanner, for
# simulators without a camera. Never set it in a build that ships.
EXPO_PUBLIC_E2E=0

# Application id (Android package and iOS bundle id). Defaults to com.passripple.scanner.
# SCANNER_APP_ID=
