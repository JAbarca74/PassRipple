# App configuration. Copy to `.env` (never committed) and fill in.
# Every VITE_* value ends up in the browser bundle: only public identifiers here, no secrets.
# No analytics or other third-party IDs belong here: the app origin runs no third-party
# scripts (invariant I8).

# Origin of the public site, for links back to event pages.
VITE_SITE_URL=http://localhost:5173
