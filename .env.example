# Server-side configuration template. Copy to `.env` (never committed) and fill in.
# Nothing reads this file yet: the workers will take these values as Cloudflare Workers
# secrets (`wrangler secret put`) in production and from `.dev.vars` locally.
# Browser-visible values live in each app's own `.env` (VITE_* variables), never here.

# ── Domain ────────────────────────────────────────────────────────────────────
PUBLIC_DOMAIN=passripple.com
SITE_URL=https://passripple.com
APP_URL=https://app.passripple.com

# ── Database (Neon) ───────────────────────────────────────────────────────────
# See db/README.md, "Production database (Neon)". The database scripts do NOT read
# this file, on purpose: a .env pointing at Neon must never turn a local
# `pnpm db:migrate` into a production one. Export the variable in the shell for the
# one command that needs it, or store it as a CI secret.
#
# Neon's administrative connection, used only by `pnpm db:migrate` (and `pnpm db:test`
# on a development branch). Leave it unset locally: the scripts then use the Docker
# database. Secret.
DATABASE_URL=
# Connection as passripple_api, the role the API uses. Used only once, to create the
# Hyperdrive configuration (`wrangler hyperdrive create`); the API itself reaches the
# database through the Hyperdrive binding and never reads this value. Secret.
API_DATABASE_URL=

# ── Organization mailboxes (Google Workspace) ─────────────────────────────────
# Addresses on the company domain. Inbound mail for the domain is handled by
# Google Workspace; transactional mail (confirmations, sign-in codes) goes out
# through the outgoing mail provider below, from MAIL_FROM_ADDRESS.
CONTACT_EMAIL=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
SECURITY_EMAIL=

# ── Outgoing transactional mail ───────────────────────────────────────────────
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PassRipple
MAIL_REPLY_TO=

# ── Google Cloud project ──────────────────────────────────────────────────────
# Shared by Firebase Cloud Messaging and Play Integrity.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Service account key as one line of JSON. Secret: Workers secret only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Firebase (push notifications and crash reports for the gate app) ──────────
FIREBASE_PROJECT_ID=

# ── Google Play (gate app) ────────────────────────────────────────────────────
PLAY_PACKAGE_NAME=

# ── Google Analytics 4: server-side conversions (Measurement Protocol) ────────
# Sent only when the buyer gave consent (analytics module).
GA4_MEASUREMENT_ID=
# Secret: Workers secret only.
GA4_API_SECRET=
