# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
.expo/
.wrangler/
coverage/
*.tsbuildinfo

# Environment and secrets: never commit these
.env
.env.*
!.env.example
.dev.vars
# Service account keys and other credential files (workers/api/.secrets/, ADR 0028)
.secrets/
*.jks
*.pem
*.key
*.p12
*.keystore
# Apple signing material and App Store Connect API keys
*.p8
*.cer
*.mobileprovision
# Signed app builds: they carry the signing certificate and must come from CI only
*.apk
*.aab
*.ipa
# Package manager credentials
.npmrc
google-services.json
GoogleService-Info.plist
credentials*.json
service-account*.json

# Database dumps and exports
*.dump
*.sql.gz
backups/

# Design and business documents (including the private design guide): kept local only
docs/

# Real bank notices and personal data: only anonymized fixtures are allowed
**/bank-notices/real/
**/exports/

# Local AI assistant settings and instructions: never commit these
.claude/
CLAUDE.md

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local development fixtures: QR images and codes of fictitious test tickets
.dev-fixtures/
